#!/usr/bin/env bash
# Local build of the release firmwares for one target and layout, PC and Mac.
# Run from the root of a west workspace separate from this repo, initialized from a copy
# of its config/: `mkdir ws && cp -R <quacken>/config ws/ && cd ws && west init -l config && west update`.
set -euo pipefail

if [ $# -ne 2 ]; then
	echo "Usage: $0 TARGET LAYOUT"
	echo "  TARGET: flex | zero"
	echo "  LAYOUT: qwerty | qwerty_intl | qwerty_lafayette | dvorak | azerty | ergol | erglace | bepo | bepolar"
	exit 1
fi

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
for os in pc mac; do
	"$SCRIPT_DIR/scripts/build_variants.sh" "$1" "$2" "$os"
done
